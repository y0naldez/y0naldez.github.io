---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Heading = {
	depth: number;
	slug: string;
	text: string;
};

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: Heading[];
	lang?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	lang = 'en',
	headings = [],
} = Astro.props as Props;

const tocHeadings = headings
	.filter((item) => item.depth === 2 || item.depth === 3)
	.map((item) => ({
		text: item.text,
		href: `#${item.slug}`,
		className: `depth-${item.depth}`,
	}));

const tocLabel = lang === 'es' ? 'Contenido' : 'Content';
const tocCollapseLabel = lang === 'es' ? 'Contraer contenido' : 'Collapse content';
const tocExpandLabel = lang === 'es' ? 'Expandir contenido' : 'Expand content';
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} />
		<style>
			html {
				scroll-behavior: smooth;
			}

			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}

			article {
				width: 100%;
			}

			.hero-image {
				width: min(100% - 2rem, 980px);
				margin: 2rem auto 0;
			}

			.hero-image img {
				display: block;
				width: 100%;
				height: 360px;
				object-fit: cover;
				margin: 0 auto;
				border-radius: 18px;
				box-shadow: var(--box-shadow);
				border: 1px solid rgb(var(--gray-light));
			}

			.post-shell {
				display: grid;
				grid-template-columns: minmax(0, 280px) minmax(0, 820px) 280px;
				grid-template-areas: '. post toc';
				gap: 3rem;
				align-items: start;
				width: min(100% - 2rem, 1480px);
				margin: 2rem auto 4rem;
			}

			.prose {
				grid-area: post;
				width: 100%;
				margin: 0;
				padding: 2.25rem;
				color: rgb(var(--gray-dark));
				font-size: 1rem;
				line-height: 1.8;
				background: color-mix(in srgb, var(--surface) 78%, transparent);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 22px;
				box-shadow: 0 18px 60px rgba(0, 0, 0, 0.18);
			}

			.toc {
				grid-area: toc;
				position: fixed;
				top: 5rem;
				right: max(1rem, calc((100vw - 1480px) / 2));
				z-index: 20;
				align-self: start;
				width: 280px;
				max-height: calc(100vh - 7rem);
				overflow-y: auto;
				padding: 1.25rem;
				background: color-mix(in srgb, var(--surface) 82%, transparent);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 18px;
				box-shadow: 0 14px 36px rgba(0, 0, 0, 0.14);
				transition:
					opacity 0.2s ease,
					visibility 0.2s ease,
					transform 0.2s ease;
			}

			.toc.is-hidden-at-footer {
				opacity: 0;
				visibility: hidden;
				pointer-events: none;
				transform: translateY(-0.75rem);
			}

			.toc.is-hidden-before-post {
				opacity: 0;
				visibility: hidden;
				pointer-events: none;
				transform: translateY(0.75rem);
			}

			.toc::-webkit-scrollbar {
				width: 0.45rem;
			}

			.toc::-webkit-scrollbar-track {
				background: transparent;
			}

			.toc::-webkit-scrollbar-thumb {
				background: color-mix(in srgb, rgb(var(--gray)) 45%, transparent);
				border-radius: 999px;
			}

			.toc-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				margin-bottom: 0.9rem;
			}

			.toc-title {
				margin: 0;
				color: rgb(var(--black));
				font-size: 0.78rem;
				font-weight: 900;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.toc-toggle {
				display: inline-grid;
				place-items: center;
				flex: 0 0 auto;
				width: 2rem;
				height: 2rem;
				padding: 0;
				color: rgb(var(--gray));
				font: inherit;
				font-size: 1.05rem;
				font-weight: 900;
				line-height: 1;
				background: transparent;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				cursor: pointer;
				transition:
					color 0.2s ease,
					background 0.2s ease,
					border-color 0.2s ease;
			}

			.toc-toggle:hover,
			.toc-toggle:focus-visible {
				color: var(--accent);
				background: color-mix(in srgb, var(--surface) 72%, var(--accent) 28%);
				border-color: var(--accent);
			}

			.toc.is-collapsed {
				width: 3.5rem;
				max-height: none;
				overflow: visible;
				padding: 0.75rem;
			}

			.toc.is-collapsed .toc-header {
				justify-content: center;
				margin-bottom: 0;
			}

			.toc.is-collapsed .toc-title,
			.toc.is-collapsed .toc-list {
				display: none;
			}

			.toc-list {
				display: grid;
				gap: 0.2rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}

			.toc a {
				display: block;
				padding: 0.45rem 0;
				color: rgb(var(--gray));
				font-size: 0.92rem;
				line-height: 1.35;
				text-decoration: none;
				border-left: 2px solid transparent;
				transition:
					color 0.2s ease,
					background 0.2s ease,
					border-color 0.2s ease,
					box-shadow 0.2s ease,
					padding-left 0.2s ease;
			}

			.toc a:hover,
			.toc a:focus-visible {
				padding-left: 0.45rem;
				color: var(--accent);
				border-left-color: var(--accent);
			}

			.toc a.is-active {
				padding-left: 0.45rem;
				color: var(--accent);
				background: color-mix(in srgb, var(--surface) 78%, var(--accent) 22%);
				border-left-color: var(--accent);
				border-radius: 0 10px 10px 0;
				box-shadow: inset 10px 0 18px -16px var(--accent);
			}

			.toc .depth-3 a {
				padding-left: 0.85rem;
				font-size: 0.86rem;
			}

			.toc .depth-3 a:hover,
			.toc .depth-3 a:focus-visible {
				padding-left: 1.3rem;
			}

			.toc .depth-3 a.is-active {
				padding-left: 1.3rem;
			}

			.title {
				margin-bottom: 2.75rem;
				padding-bottom: 1.75rem;
				text-align: center;
				border-bottom: 1px solid rgb(var(--gray-light));
			}

			.title h1 {
				margin: 0.4rem 0 0;
				font-size: clamp(2rem, 5vw, 3rem);
				line-height: 1.05;
				letter-spacing: -0.045em;
				color: rgb(var(--black));
			}

			.date {
				margin-bottom: 0.75rem;
				color: rgb(var(--gray));
				font-size: 0.95rem;
				font-weight: 600;
			}

			.last-updated-on {
				font-style: italic;
				margin-top: 0.25rem;
				font-weight: 400;
			}

			.prose :global(p) {
				margin: 0 0 1.35rem;
				text-align: justify;
				text-wrap: pretty;
				color: color-mix(in srgb, rgb(var(--gray-dark)) 92%, rgb(var(--black)) 8%);
			}

			.prose :global(h2),
			.prose :global(h3),
			.prose :global(h4) {
				scroll-margin-top: 1.5rem;
			}

			.prose :global(h2) {
				position: relative;
				margin-top: 4.25rem;
				margin-bottom: 1.5rem;
				padding: 1.2rem 1.3rem 1.2rem 1.5rem;
				font-size: clamp(1.7rem, 4vw, 2.25rem);
				line-height: 1.12;
				letter-spacing: -0.04em;
				color: rgb(var(--black));
				background: linear-gradient(
					90deg,
					color-mix(in srgb, var(--accent) 18%, transparent),
					transparent 85%
				);
				border-left: 5px solid var(--accent);
				border-radius: 16px;
			}

			.prose :global(h2:not(:first-child))::after {
				content: '';
				position: absolute;
				top: -2.15rem;
				left: 0;
				right: 0;
				height: 1px;
				background: linear-gradient(
					90deg,
					transparent,
					rgb(var(--gray-light)),
					transparent
				);
			}

			.prose :global(h2)::before {
				content: '';
				position: absolute;
				left: 1.5rem;
				bottom: -0.75rem;
				width: 4rem;
				height: 3px;
				border-radius: 999px;
				background: var(--accent);
			}

			.prose :global(h3) {
				position: relative;
				margin-top: 2.75rem;
				margin-bottom: 1rem;
				padding: 0.95rem 1.1rem;
				font-size: clamp(1.25rem, 3vw, 1.6rem);
				line-height: 1.2;
				letter-spacing: -0.025em;
				color: rgb(var(--black));
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
			}

			.prose :global(h3)::before {
				content: '#';
				margin-right: 0.45rem;
				color: var(--accent);
				font-weight: 900;
			}

			.prose :global(h4) {
				margin-top: 2rem;
				margin-bottom: 0.75rem;
				font-size: 1.15rem;
				color: rgb(var(--black));
			}

			.prose :global(ul),
			.prose :global(ol) {
				margin: 0 0 1.6rem;
				padding-left: 1.4rem;
			}

			.prose :global(li) {
				margin-bottom: 0.55rem;
				padding-left: 0.15rem;
			}

			.prose :global(li::marker) {
				color: var(--accent);
				font-weight: 700;
			}

			.prose :global(a) {
				color: var(--accent);
				text-decoration-thickness: 2px;
				text-underline-offset: 3px;
				font-weight: 600;
			}

			.prose :global(a:hover) {
				color: var(--accent-dark);
			}

			.prose :global(blockquote) {
				margin: 2rem 0;
				padding: 1.1rem 1.25rem;
				border-left: 4px solid var(--accent);
				background: color-mix(in srgb, var(--surface) 88%, var(--accent) 12%);
				border-radius: 0 14px 14px 0;
				font-size: 1.02rem;
				color: rgb(var(--gray-dark));
			}

			.prose :global(blockquote p) {
				margin-bottom: 0;
			}

			.prose :global(code) {
				font-size: 0.9em;
				padding: 0.15rem 0.35rem;
				border-radius: 6px;
				border: 1px solid rgb(var(--gray-light));
				background: var(--code-bg);
			}

			.prose :global(pre) {
				margin: 2rem 0;
				padding: 1.25rem;
				overflow-x: auto;
				border-radius: 14px;
				background: #080c14;
				color: #e5e7eb;
				font-size: 0.92rem;
				line-height: 1.65;
				border: 1px solid rgb(var(--gray-light));
				box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
			}

			.prose :global(pre code) {
				all: unset;
				font-family:
					ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
					'Courier New', monospace;
			}

			.prose :global(img) {
				display: block;
				margin: 2rem auto;
				border-radius: 16px;
				box-shadow: var(--box-shadow);
				border: 1px solid rgb(var(--gray-light));
			}

			.prose :global(hr) {
				margin: 2.75rem 0;
				border: none;
				border-top: 1px solid rgb(var(--gray-light));
			}

			.prose :global(table) {
				width: 100%;
				margin: 2rem 0;
				border-collapse: separate;
				border-spacing: 0;
				overflow: hidden;
				border-radius: 16px;
				background: var(--surface);
				border: 1px solid rgb(var(--gray-light));
				box-shadow: 0 12px 36px rgba(0, 0, 0, 0.16);
			}

			.prose :global(th),
			.prose :global(td) {
				padding: 0.95rem 1rem;
				text-align: left;
				border-bottom: 1px solid rgb(var(--gray-light));
			}

			.prose :global(th) {
				color: rgb(var(--black));
				background: color-mix(in srgb, var(--surface) 70%, var(--accent) 30%);
				font-weight: 800;
				letter-spacing: -0.01em;
			}

			.prose :global(td) {
				color: rgb(var(--gray-dark));
			}

			.prose :global(tr:last-child td) {
				border-bottom: none;
			}

			.prose :global(tbody tr) {
				transition: background 0.2s ease;
			}

			.prose :global(tbody tr:hover) {
				background: color-mix(in srgb, var(--surface) 82%, var(--accent) 18%);
			}

			.prose :global(table code) {
				white-space: nowrap;
			}

			.prose :global(strong) {
				color: rgb(var(--black));
			}

			@media (max-width: 900px) {
				.post-shell {
					display: flex;
					flex-direction: column;
					width: calc(100% - 1rem);
					gap: 1rem;
					margin-top: 1rem;
					margin-bottom: 3rem;
				}

				.toc {
					display: none;
				}
			}

			@media (max-width: 720px) {
				.hero-image {
					width: calc(100% - 1rem);
					margin-top: 1rem;
				}

				.hero-image img {
					height: 220px;
					border-radius: 14px;
				}

				.prose {
					padding: 1.25rem;
					font-size: 0.98rem;
					line-height: 1.75;
					border-radius: 18px;
				}

				.title {
					margin-bottom: 2rem;
					padding-bottom: 1.25rem;
				}

				.title h1 {
					font-size: clamp(1.8rem, 9vw, 2.35rem);
				}

				.prose :global(p) {
					text-align: left;
				}

				.prose :global(h2) {
					font-size: clamp(1.45rem, 8vw, 1.95rem);
					margin-top: 3rem;
					padding: 1rem 1rem 1rem 1.25rem;
				}

				.prose :global(h2:not(:first-child))::after {
					top: -1.6rem;
				}

				.prose :global(h3) {
					font-size: clamp(1.15rem, 6vw, 1.45rem);
					padding: 0.85rem 1rem;
				}

				.prose :global(table) {
					display: block;
					overflow-x: auto;
					white-space: nowrap;
					font-size: 0.92rem;
				}

				.prose :global(th),
				.prose :global(td) {
					padding: 0.8rem 0.9rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={980} height={360} src={heroImage} alt="" />
						</div>
					)
				}

				<div class="post-shell">
					<div class="prose">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>

							<h1>{title}</h1>
						</div>

						<slot />
					</div>

					{
						tocHeadings.length > 0 && (
							<aside class="toc" aria-label={tocLabel}>
								<div class="toc-header">
									<p class="toc-title">{tocLabel}</p>
									<button
										class="toc-toggle"
										type="button"
										aria-label={tocCollapseLabel}
										aria-expanded="true"
										data-collapse-label={tocCollapseLabel}
										data-expand-label={tocExpandLabel}
									>
										›
									</button>
								</div>
								<ol class="toc-list">
									{tocHeadings.map((item) => (
										<li class={item.className}>
											<a href={item.href}>{item.text}</a>
										</li>
									))}
								</ol>
							</aside>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
		<script>
			const toc = document.querySelector('.toc');
			const tocToggle = document.querySelector('.toc-toggle');
			const postShell = document.querySelector('.post-shell');
			const footer = document.querySelector('footer');

			if (toc && postShell && footer) {
				const updateTocVisibility = () => {
					const postTop = postShell.getBoundingClientRect().top;
					const footerTop = footer.getBoundingClientRect().top;
					const shouldHideBeforePost = postTop > 96;
					const shouldHideAtFooter = footerTop < window.innerHeight - 80;

					toc.classList.toggle('is-hidden-before-post', shouldHideBeforePost);
					toc.classList.toggle('is-hidden-at-footer', shouldHideAtFooter);
				};

				updateTocVisibility();
				window.addEventListener('scroll', updateTocVisibility, { passive: true });
				window.addEventListener('resize', updateTocVisibility);
			}

			if (toc && tocToggle) {
				const storageKey = 'blog-toc-collapsed';
				const collapseLabel = tocToggle.dataset.collapseLabel || 'Collapse content';
				const expandLabel = tocToggle.dataset.expandLabel || 'Expand content';

				const setCollapsed = (isCollapsed) => {
					toc.classList.toggle('is-collapsed', isCollapsed);
					tocToggle.setAttribute('aria-expanded', String(!isCollapsed));
					tocToggle.setAttribute('aria-label', isCollapsed ? expandLabel : collapseLabel);
					tocToggle.textContent = isCollapsed ? '‹' : '›';
					localStorage.setItem(storageKey, String(isCollapsed));
				};

				setCollapsed(localStorage.getItem(storageKey) === 'true');
				tocToggle.addEventListener('click', () => {
					setCollapsed(!toc.classList.contains('is-collapsed'));
				});
			}

			if (toc) {
				const tocLinks = Array.from(toc.querySelectorAll('a[href^="#"]'));
				const sections = tocLinks
					.map((link) => {
						const id = decodeURIComponent(link.getAttribute('href').slice(1));
						const heading = document.getElementById(id);

						return heading ? { link, heading } : null;
					})
					.filter(Boolean);

				const setActiveSection = () => {
					let activeSection = sections[0];

					for (const section of sections) {
						if (section.heading.getBoundingClientRect().top <= 160) {
							activeSection = section;
						}
					}

					for (const section of sections) {
						const isActive = section === activeSection;

						section.link.classList.toggle('is-active', isActive);
						section.link.toggleAttribute('aria-current', isActive);
					}
				};

				setActiveSection();
				window.addEventListener('scroll', setActiveSection, { passive: true });
				window.addEventListener('resize', setActiveSection);
			}
		</script>
	</body>
</html>
