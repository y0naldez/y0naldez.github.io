---
import { CONTACT_EMAIL } from '../consts';

const today = new Date();
const isEnglish = Astro.url.pathname.startsWith('/en');
const contactLabel = isEnglish ? 'Contact' : 'Contacto';
---

<footer>
	<div class="social-links">
		<a class="contact-link" href={`mailto:${CONTACT_EMAIL}`}>
			<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
				<path
					fill="currentColor"
					d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"
				/>
			</svg>
			<span>{contactLabel}: {CONTACT_EMAIL}</span>
		</a>
	</div>
	<p>&copy; {today.getFullYear()} B4NGG. All rights reserved.</p>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		margin-bottom: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}
	.contact-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	footer p {
		margin: 0;
	}
</style>
