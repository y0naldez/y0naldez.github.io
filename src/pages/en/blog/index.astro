---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import BlogLibrary from '../../../components/BlogLibrary.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

const posts = (await getCollection('blog'))
	.filter((post) => post.data.lang === 'en')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head><BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>{posts.length > 0 ? <BlogLibrary posts={posts} lang="en" /> : <p>No English posts have been published yet.</p>}</main>
		<Footer />
	</body>
</html>
