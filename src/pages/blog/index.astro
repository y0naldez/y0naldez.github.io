---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import BlogLibrary from '../../components/BlogLibrary.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
	.filter((post) => post.data.lang === 'es')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="es">
	<head><BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>{posts.length > 0 ? <BlogLibrary posts={posts} lang="es" /> : <p>Todavía no hay posts publicados en español.</p>}</main>
		<Footer />
	</body>
</html>
